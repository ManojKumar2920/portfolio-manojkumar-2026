---
import '../styles/global.css';
import { site } from '../site';
import { graph, ORIGIN, PERSON_ID } from '../seo';

interface Props {
  title?: string;
  description?: string;
  namespace: 'home' | 'about' | 'work' | 'works' | 'credits' | 'notfound';
  /** social card image (absolute path on this site); defaults to the name card */
  image?: string;
  /** schema.org nodes for this page, added to the site-wide Person and WebSite */
  schema?: object[];
  /** og:type: 'website' for most pages, 'profile' for About, 'article' for case studies */
  type?: string;
}
const { title, description = site.pitch, namespace, image = '/og.jpg', schema = [], type = 'website' } = Astro.props;
const fullTitle = title ? `${title} · ${site.name}` : `${site.name} · ${site.role} in Chennai`;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const canonical = new URL(path, ORIGIN).href;
const imageUrl = new URL(image, ORIGIN).href;
const noindex = namespace === 'notfound';
// every page names its subject; the home page also says it is the site's front page
const pageNode = {
  '@type': namespace === 'about' ? 'ProfilePage' : 'WebPage',
  '@id': `${canonical}#page`,
  url: canonical,
  name: fullTitle,
  description,
  isPartOf: { '@id': `${ORIGIN}/#website` },
  about: { '@id': PERSON_ID },
  ...(namespace === 'about' || namespace === 'home' ? { mainEntity: { '@id': PERSON_ID } } : {}),
  primaryImageOfPage: imageUrl,
};
const ld = graph(pageNode, ...schema);
const links = [
  { href: '/about', label: 'About' },
  { href: '/work', label: 'Work' },
];
---

<!doctype html>
<html lang="en" class={namespace === 'home' ? 'is-home' : ''} data-page={namespace}>
  <head>
    <script is:inline>document.documentElement.classList.add('js');</script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="author" content={site.name} />
    {noindex ? <meta name="robots" content="noindex" /> : <meta name="robots" content="index, follow, max-image-preview:large" />}
    {!noindex && <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content="#0c0e11" />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en_IN" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name}, ${site.role}`} />
    {type === 'profile' && <meta property="profile:first_name" content="Manoj" />}
    {type === 'profile' && <meta property="profile:last_name" content="Kumar" />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" href="/icon-192.png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap.xml" />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="About this site, for AI assistants" />
    <script type="application/ld+json" set:html={ld} />
    <link rel="preload" href="/fonts/season-sans-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/season-mix-300-italic.woff2" as="font" type="font/woff2" crossorigin />
    {namespace === 'home' && <link rel="preload" href="/models/ruin.glb" as="fetch" crossorigin="anonymous" />}
    {namespace === 'home' && <link rel="preload" href="/models/trees.glb" as="fetch" crossorigin="anonymous" />}
    <title>{fullTitle}</title>
  </head>
  <body>
    <canvas id="gl" aria-hidden="true"></canvas>

    <div class="loader" aria-hidden="true" data-loader>
      <div class="loader-row">
        <span>Portfolio · {new Date().getFullYear()}</span>
        <span>{site.location.split(' · ')[0]}</span>
      </div>
      <div class="loader-meta">
        <span class="loader-status" data-loader-status>Surveying the hills</span>
        <span class="loader-pct"><b data-loader-pct>0</b>%</span>
      </div>
      <div class="loader-bar"><i></i></div>
      <div class="loader-name"><span data-loader-mark data-text={site.name}>{site.name}</span></div>
    </div>
    <noscript><style>.loader { display: none; }</style></noscript>

    <header class="nav" aria-label="Primary">
      <a class="brand" href="/">{site.name}</a>
      <span class="clock" aria-hidden="true">{site.location.split(',')[0]} · <time data-clock>--:--</time> IST</span>
      <nav class="links">
        <!-- the home page's soundscape (sound.ts): shown on home only -->
        <button class="sound" type="button" data-sound aria-pressed="false" aria-label="Sound off. Turn sound on">
          <span aria-hidden="true"><i></i><i></i><i></i><i></i></span>
        </button>
        {links.map((l) => (
          <a href={l.href} aria-current={path === l.href || path.startsWith(`${l.href}/`) ? 'page' : undefined}>{l.label}</a>
        ))}
        <a class="talk" href={site.booking.url} data-book>Get in touch <span aria-hidden="true">→</span></a>
        <!-- phones: About and Work move into the sheet below -->
        <button class="menu-btn" type="button" data-menu-btn aria-expanded="false" aria-controls="menu" aria-label="Open menu">
          <span aria-hidden="true"><i></i><i></i></span>
        </button>
      </nav>
    </header>

    <div class="menu" id="menu" data-menu hidden>
      <nav class="menu-links" aria-label="Menu">
        <a href="/">Home</a>
        {links.map((l) => <a href={l.href}>{l.label}</a>)}
        <a href={site.booking.url} data-book>Get in touch</a>
      </nav>
      <div class="menu-foot">
        <a href={`mailto:${site.email}`}>{site.email}</a>
        <p>{site.socials.map((s) => <a href={s.href} target="_blank" rel="noopener">{s.label}</a>)}</p>
        <p class="menu-where">{site.location.split(' · ')[0]} · <time data-clock>--:--</time> IST</p>
      </div>
    </div>

    <div class="grain" aria-hidden="true"></div>

    <div data-barba="wrapper">
      <main data-barba="container" data-barba-namespace={namespace} data-title={fullTitle}>
        <slot />
      </main>
    </div>

    <script>
      import '../scripts/app';
    </script>
  </body>
</html>

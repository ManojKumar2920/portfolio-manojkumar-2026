---
import '../styles/global.css';
import { site } from '../site';

interface Props {
  title?: string;
  description?: string;
  namespace: 'home' | 'about' | 'work' | 'works' | 'notfound';
}
const { title, description = site.pitch, namespace } = Astro.props;
const fullTitle = title ? `${title} · ${site.name}` : `${site.name} · ${site.role}`;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const links = [
  { href: '/about', label: 'About' },
  { href: '/work', label: 'Work' },
];
---

<!doctype html>
<html lang="en" class={namespace === 'home' ? 'is-home' : ''} data-page={namespace}>
  <head>
    <script is:inline>document.documentElement.classList.add('js');</script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0c0e11" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href="/fonts/season-sans-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/season-mix-300-italic.woff2" as="font" type="font/woff2" crossorigin />
    {namespace === 'home' && <link rel="preload" href="/models/ruin.glb" as="fetch" crossorigin="anonymous" />}
    {namespace === 'home' && <link rel="preload" href="/models/trees.glb" as="fetch" crossorigin="anonymous" />}
    <title>{fullTitle}</title>
  </head>
  <body>
    <canvas id="gl" aria-hidden="true"></canvas>

    <div class="loader" aria-hidden="true" data-loader>
      <div class="loader-row">
        <span>Portfolio · {new Date().getFullYear()}</span>
        <span>{site.location.split(' · ')[0]}</span>
      </div>
      <div class="loader-meta">
        <span class="loader-status" data-loader-status>Surveying the hills</span>
        <span class="loader-pct"><b data-loader-pct>0</b>%</span>
      </div>
      <div class="loader-bar"><i></i></div>
      <div class="loader-name"><span data-loader-mark data-text={site.name}>{site.name}</span></div>
    </div>
    <noscript><style>.loader { display: none; }</style></noscript>

    <header class="nav" aria-label="Primary">
      <a class="brand" href="/">{site.name}</a>
      <span class="clock" aria-hidden="true">{site.location.split(',')[0]} · <time data-clock>--:--</time> IST</span>
      <nav class="links">
        {links.map((l) => (
          <a href={l.href} aria-current={path === l.href || path.startsWith(`${l.href}/`) ? 'page' : undefined}>{l.label}</a>
        ))}
        <a class="talk" href={site.booking.url} data-book>Get in touch <span aria-hidden="true">→</span></a>
      </nav>
    </header>

    <div class="grain" aria-hidden="true"></div>

    <div data-barba="wrapper">
      <main data-barba="container" data-barba-namespace={namespace} data-title={fullTitle}>
        <slot />
      </main>
    </div>

    <script>
      import '../scripts/app';
    </script>
  </body>
</html>
